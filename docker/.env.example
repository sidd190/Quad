# Database
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=change-me-strong-password

# Keycloak
KC_HOSTNAME=auth.yourdomain.com
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-me-strong-password

# Quad app
AUTH_SECRET=run-openssl-rand-base64-32
QUAD_ISSUER=https://yourdomain.com

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Quad <your-email@gmail.com>

# Caddy domains
QUAD_DOMAIN=yourdomain.com
KC_DOMAIN=auth.yourdomain.com
